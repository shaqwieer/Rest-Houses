# ---------------------------------------------------------------------------
#  Docker Compose configuration
#  Copy to .env in the project root:   cp .env.docker.example .env
# ---------------------------------------------------------------------------
#  docker-compose.yml reads this file. DATABASE_URL is NOT set here — compose
#  builds it from the POSTGRES_* values below and points the app at the `db`
#  service on the internal network.
# ---------------------------------------------------------------------------

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=desert_chalets
POSTGRES_USER=chalets
# REQUIRED. Compose refuses to start without it.
POSTGRES_PASSWORD=change-me-to-a-strong-password


# --- App -------------------------------------------------------------------
# REQUIRED. Signs session cookies:  openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# Public URL of the deployment. Behind a reverse proxy with a real domain use
# https://yourdomain.ae for both — they drive auth callbacks, canonical tags,
# sitemap URLs and Open Graph image URLs.
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Host port to publish the app on (container always listens on 3000).
APP_PORT=3000


# --- Admin account ---------------------------------------------------------
ADMIN_EMAIL=admin@example.ae
# REQUIRED. Bcrypt-hashed at seed time; never stored in clear.
ADMIN_PASSWORD=change-me-too
ADMIN_NAME=أبو سلطان


# --- First-run seed --------------------------------------------------------
# Set to true for the FIRST `docker compose up` to load the 8 sample استراحات.
# The entrypoint skips seeding automatically once listings exist, so leaving it
# true is harmless — but false is tidier once you are live.
RUN_SEED=true

# Branding defaults, applied only by that first seed. Afterwards edit everything
# from /admin/settings — the database is the source of truth, not this file.
SITE_NAME=استراحات الرمال
WHATSAPP_NUMBER=+971500000000
CONTACT_EMAIL=hello@example.ae
