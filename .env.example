# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values.   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# PostgreSQL, everywhere — local development, the test suite and production all
# run the same engine. `npm run db:up` starts one on 127.0.0.1:55433 from
# docker-compose.dev.yml; this URL matches it.
#
# SQLite is no longer supported. It generated SQLite-flavoured migrations that
# could never replay against production, which forced the deploy to fall back to
# `prisma db push` — and that silently skips every data migration while
# reporting success. See "Database and migrations" in README.md.
DATABASE_URL="postgresql://chalets:chalets@127.0.0.1:55433/desert_chalets?schema=public"


# --- Auth (NextAuth) -------------------------------------------------------
# Secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Absolute URL of the deployment. Required in production for correct callback
# URLs, canonical SEO tags, sitemap.xml and Open Graph image URLs.
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# --- Admin account ---------------------------------------------------------
# The seed script creates/updates this single admin login. The password is
# bcrypt-hashed before it is stored — it is never written to the DB in clear.
# Change ADMIN_PASSWORD and re-run `npm run db:seed` to rotate it.
ADMIN_EMAIL="admin@example.ae"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="أبو سلطان"


# --- Branding defaults (seed only) -----------------------------------------
# These populate the settings row the FIRST time you seed. Afterwards the
# owner edits everything from /admin/settings and these values are ignored —
# the database is the source of truth, not the environment.
SITE_NAME="استراحات الرمال"
WHATSAPP_NUMBER="+971500000000"
CONTACT_EMAIL="hello@example.ae"


# --- Time zone -------------------------------------------------------------
# The audience, the rest houses and the operator are all in the UAE, so the
# site tells the time in Gulf hours. Every date and time it *renders* applies
# UTC+4 explicitly (src/lib/dates.ts) and does not depend on this variable —
# it is here so log timestamps and any ad-hoc script agree with the pages.
TZ="Asia/Dubai"


# --- Image storage ---------------------------------------------------------
# "local"      → writes to ./public/uploads (default, zero config)
# "cloudinary" → set CLOUDINARY_* below
# "s3"         → set S3_* below
STORAGE_DRIVER="local"

# Only needed when STORAGE_DRIVER="cloudinary"
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# Only needed when STORAGE_DRIVER="s3"  (works with AWS S3, R2, MinIO, Spaces)
# S3_REGION="me-central-1"
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""            # leave blank for AWS; set for R2/MinIO/Spaces
# S3_PUBLIC_BASE_URL=""     # e.g. https://cdn.example.ae


# --- Form protection -------------------------------------------------------
# The booking form and the owner registration form are protected out of the box
# with a built-in human check: a signed, single-use proof-of-work challenge, plus
# a honeypot field and per-IP/per-phone rate limiting. That needs NO keys and no
# third-party service — leave everything below commented out and it is what runs.
#
# To swap in a real captcha instead, set the provider and both keys, then
# restart. The same widget slot on the same two forms picks it up; nothing else
# changes. "turnstile" (Cloudflare, no Google account needed) or "recaptcha"
# (Google reCAPTCHA v2 "I'm not a robot" checkbox).
#   Turnstile keys: https://dash.cloudflare.com → Turnstile → Add site
#   reCAPTCHA keys: https://www.google.com/recaptcha/admin → v2 checkbox
#
# NOTE: if CAPTCHA_PROVIDER is set but a key is missing, the app logs a warning
# and falls back to the built-in check rather than breaking the forms.
# CAPTCHA_PROVIDER="turnstile"
# CAPTCHA_SITE_KEY=""
# CAPTCHA_SECRET_KEY=""

# Difficulty of the built-in check, in leading zero bits. Default 12 (~4,096
# hashes — a fraction of a second on a phone, and 4,096× the cost for a spammer
# on every attempt). Each +1 doubles both. Clamped to 8–20.
# HUMAN_CHECK_DIFFICULTY="12"


# --- Uploaded photo compression ---------------------------------------------
# Every listing photo is recompressed with sharp before it is stored: the
# longest edge is capped at 2560px and the file re-encoded as WebP q82, which
# turns a typical 6 MB phone photo into 250–450 KB with no visible difference.
# EXIF (including GPS) is stripped. See src/lib/storage/optimize.ts.
#
# On by default and there is rarely a reason to change it — with
# STORAGE_DRIVER="db" the photos live in Postgres and therefore in every backup.
# "off" stores originals; useful only for diagnosing a suspected encoder issue.
# IMAGE_OPTIMIZE="on"


# --- Calendar sync (Airbnb / Booking.com) -----------------------------------
# Shared secret for POST /api/calendar/sync, the endpoint the host cron calls
# every 15 minutes to pull each listing's external iCal feeds.
#
# REQUIRED for the sync to run on a schedule. The endpoint refuses every request
# with 503 while this is unset rather than running open — it makes outbound
# requests to every feed URL on the platform, so an unauthenticated version
# would be a request amplifier.
#
# Generate one with:  openssl rand -hex 32
# The crontab line and the nginx note are in DEPLOYMENT.md.
# CRON_SECRET=""

# NOTE: the public .ics export URL each listing can publish is built from
# NEXT_PUBLIC_SITE_URL (set at the top of this file). If that is wrong, the URL
# an owner pastes into Airbnb points at the wrong host.


# --- Payments (not enabled yet) --------------------------------------------
# The deposit-payment flow is a deliberate stub — see src/lib/payments/index.ts.
# Turn it on from /admin/settings once a provider is wired.
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
