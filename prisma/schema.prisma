// ---------------------------------------------------------------------------
// Prisma schema — منصة حجز الاستراحات
// ---------------------------------------------------------------------------
// PostgreSQL is the one provider — local development, the test suite and
// production all run it. Start a local server with `npm run db:up`
// (docker-compose.dev.yml) and point DATABASE_URL at it.
//
// ─── Why not SQLite locally ─────────────────────────────────────────────────
// This project used to default to SQLite for zero-setup local development and
// switch to PostgreSQL only inside the Docker build. That convenience had a
// concrete cost: `prisma migrate dev` generated SQLite-flavoured migrations
// (PRAGMA, table-rebuild RedefineTables blocks) which could never replay
// against production. So `docker/migrate.sh` fell back to `prisma db push`,
// which syncs the *schema* but reads no migration SQL at all — meaning every
// data migration was silently skipped while the deploy logged
// "🚀 Your database is now in sync with your Prisma schema."
//
// That was found the hard way: a release whose city-id remap never ran in
// production, leaving rows pointing at ids the application no longer knew.
// One provider everywhere means a migration that passes locally is a migration
// that will run in production.
//
// ─── Deliberate schema constraints, still worth keeping ─────────────────────
// These were originally SQLite compatibility measures. They are retained on
// their own merits, so changing them is a decision rather than an accident:
//   * no native `enum` → status fields are String, validated by the guards in
//     `src/lib/constants.ts`. Adding a value is a code change, not a migration
//     that locks the table.
//   * amenity + category id lists are JSON text, not `String[]`. See the note
//     on `findListings` in src/lib/listings.ts for what that costs and why the
//     in-memory filter is correct at this catalogue size.
//   * calendar days are "YYYY-MM-DD" strings, never DateTime — a booked day is
//     a calendar fact, not an instant, and must not shift across a UTC
//     boundary. See src/lib/dates.ts.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth — the account record behind a login (NextAuth credentials provider).
//
// `role` is one of ROLES in src/lib/constants.ts:
//   "ADMIN"  — platform operator; full access to /admin
//   "OWNER"  — rest-house owner; access to /owner *only once approved*
//
// The default stays "ADMIN" so the seeded operator account and every row that
// existed before owners were introduced keep working unchanged. An owner row is
// always created explicitly with role="OWNER" by the registration action.
//
// IMPORTANT: role alone never grants owner access. Whether an owner may act is
// decided by their OwnerProfile status + membership expiry, re-read from the
// database on every request — see `requireApprovedOwner()` in src/lib/auth.ts.
// A 30-day JWT would otherwise keep saying "approved" for a month after an
// admin suspends the account.
// ---------------------------------------------------------------------------
model User {
  id           String   @id @default(cuid())
  email        String   @unique

  // ---------------------------------------------------------------------
  // The owner's sign-in name: their phone number, canonical digits, no "+".
  //
  //     971503322119
  //
  // Owners were asked to remember an email address for an account they use a
  // handful of times a year. They know their own mobile number. So the number
  // they already gave at registration *is* the username, kept in the exact
  // shape `normalizePhone()` produces (src/lib/phone.ts) — one string, so a
  // number typed as "+971 50 332 2119" at registration and "0503322119" at
  // login resolves to the same account.
  //
  // Nullable, and both reasons matter:
  //   * the ADMIN account signs in with an email and has no phone to derive
  //     one from. NULL means "this account has no username", not "empty".
  //   * the backfill migration deliberately skips any owner whose normalised
  //     number collides with another's. PostgreSQL permits many NULLs under a
  //     unique index, so the two of them land as NULL for an operator to
  //     resolve rather than failing the migration and stopping the deploy.
  //
  // An email address signs in operators only — see `authorize()` in
  // src/lib/auth.ts. So for an OWNER this column is the *only* credential, and
  // an owner left NULL by that collision cannot sign in until an operator gives
  // them a distinct number from /admin/owners. That surface shows the username
  // (or "—") on every row precisely so the case is visible rather than silent.
  username     String?  @unique

  name         String?
  passwordHash String
  role         String   @default("ADMIN") // "ADMIN" | "OWNER"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownerProfile OwnerProfile?
  auditLogs    AuditLog[]    @relation("AuditActor")

  @@index([role])
}

// ---------------------------------------------------------------------------
// OwnerProfile — the business record for a rest-house owner.
//
// Kept as its own model rather than columns on `User` for two reasons:
//   * the auth record stays minimal (email + hash + role), so a query that
//     needs a login never accidentally selects private business data —
//     phone, WhatsApp, ID number are exposed only through the admin views
//   * a registration *request* is a first-class object with its own lifecycle
//     (submitted → reviewed → approved/rejected → suspended/expired), which is
//     a poor fit for flags smeared across the account table
//
// `status` is one of OWNER_STATUSES in src/lib/constants.ts — String rather
// than a native enum, per the portability note at the top of this file:
//   "PENDING"   — submitted, awaiting admin review (cannot publish)
//   "APPROVED"  — active; may manage and publish listings
//   "REJECTED"  — refused by an admin; `rejectionReason` explains why
//   "SUSPENDED" — was approved, then switched off by an admin
//
// membershipExpiresAt is a *query-time* predicate, never a stored "expired"
// flag and never something that rewrites Listing.published. Expiry must hide
// listings without destroying the owner's own publish intent, so that renewing
// restores exactly the listings that were live before. See
// `publicListingWhere()` in src/lib/listings.ts.
// ---------------------------------------------------------------------------
model OwnerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Account + business information collected at registration.
  fullName     String
  // Stored in the canonical form `normalizePhone()` produces — digits, country
  // code first, no "+". This is not merely tidiness: `User.username` is derived
  // from this column, so a number stored as typed would be a login nobody could
  // reproduce. See src/lib/phone.ts.
  phone        String
  whatsapp     String // drives every wa.me link on this owner's listings
  businessName String  @default("")
  idNumber     String? // Emirates ID / trade licence, optional
  city         String  @default("") // one of CITIES ids, or "" if unspecified
  about        String  @default("")

  status          String    @default("PENDING")
  rejectionReason String?
  reviewedAt      DateTime?
  reviewedById    String?

  // null = no expiry set yet (a pending owner). A date in the past hides every
  // listing this owner has, without unpublishing any of them.
  membershipExpiresAt DateTime?

  listings Listing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([status, membershipExpiresAt])
}

// ---------------------------------------------------------------------------
// AuditLog — an append-only record of consequential admin actions.
//
// Written inside the same transaction as the change it describes, so a log
// entry can never exist for a change that rolled back (or vice versa).
//
// `metadata` is JSON text rather than a native JSON column, for the same
// SQLite/PostgreSQL portability reason as Listing.amenities.
// ---------------------------------------------------------------------------
model AuditLog {
  id String @id @default(cuid())

  // Kept as a nullable relation + a denormalised email, so the log survives
  // the deletion of the account that performed the action.
  actorId    String?
  actor      User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String  @default("")
  actorRole  String  @default("")

  action     String // one of AUDIT_ACTIONS in src/lib/constants.ts
  entityType String // "OwnerProfile" | "Listing" | "BookingRequest" | …
  entityId   String
  summary    String @default("")
  metadata   String @default("{}") // JSON text

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([action])
}

// ---------------------------------------------------------------------------
// Site settings — a single row (id = 1) holding everything brandable.
// Nothing that appears here should ever be hardcoded in a component: the whole
// point is that the owner can rebrand from /admin/settings without a deploy.
// Read it through `getSettings()` in src/lib/settings.ts (cached per request).
// ---------------------------------------------------------------------------
model SiteSettings {
  id Int @id @default(1)

  // Identity
  siteName    String  @default("استراحات الرمال")
  tagline     String  @default("استراحات وشاليهات الإمارات")
  logoUrl     String? // uploaded via the image adapter; falls back to the "و" monogram
  logoGlyph   String  @default("و") // single letter shown when there is no logo image

  // ---------------------------------------------------------------------
  // English siblings for every stored piece of *copy*.
  //
  // The settings row holds marketing text the operator edits without a
  // deploy — the hero, the tagline, the footer blurb, the SEO strings. Those
  // are the most visible words on the site, so leaving them Arabic-only would
  // make the English site half-translated no matter how complete the
  // dictionary is.
  //
  // All nullable and all empty by default: `localizedSetting()` in
  // src/lib/settings.ts falls back to the Arabic value whenever the English
  // one is blank, so an operator who never fills these in sees exactly the
  // behaviour they had before.
  // ---------------------------------------------------------------------
  // These carry real English defaults rather than "" so a fresh install has a
  // genuinely English English site out of the box. The fallback to Arabic still
  // exists for any field an operator later clears.
  siteNameEn       String? @default("Sands Rest Houses")
  taglineEn        String? @default("Rest houses & chalets across the UAE")
  addressLineEn    String? @default("Dubai — United Arab Emirates")
  checkInTimeEn    String? @default("4 PM")
  checkOutTimeEn   String? @default("12 noon")
  seoTitleEn       String? @default("Book rest houses and chalets in the UAE")
  seoDescriptionEn String? @default("Verified desert rest houses and chalets across Abu Dhabi, Dubai, Sharjah, Ras Al Khaimah, Ajman, Umm Al Quwain and Fujairah — clear pricing, a live calendar, and direct confirmation on WhatsApp.")
  heroTitleEn      String? @default("Your rest house in the heart of the desert")
  heroTitleAltEn   String? @default("is one booking away")
  heroSubtitleEn   String? @default("Choose from carefully selected rest houses and chalets in Lahbab, Liwa and Al Ain — clear pricing, a live calendar, and direct confirmation with the owner.")
  footerAboutEn    String? @default("An Emirati platform for booking desert rest houses and chalets — verified in person, with clear pricing.")

  // Contact — whatsappNumber drives every wa.me deep link on the site
  whatsappNumber String  @default("+971500000000")
  phone          String? @default("+971500000000")
  email          String? @default("hello@example.ae")

  // Social links (empty string / null hides the icon)
  instagram String? @default("")
  tiktok    String? @default("")
  snapchat  String? @default("")
  youtube   String? @default("")

  // ---------------------------------------------------------------------
  // The platform's own bank account — where owners send their commission.
  //
  // This is the counterpart to step 6 of the booking workflow. That step has
  // always asked the owner to transfer `commissionDue` and type a reference,
  // without ever telling them *where* to send it: the account details lived in
  // a WhatsApp message somewhere, which is exactly the kind of thing that goes
  // stale and gets mistyped. Now the step renders them.
  //
  // Stored on the settings row rather than hardcoded for the same reason as
  // everything else here — the operator changes bank without a deploy.
  //
  // All default to "": an empty field renders nothing at all rather than an
  // empty label, and a platform that has not filled these in sees precisely the
  // step it had before. Not validated beyond a length cap, deliberately —
  // account-number and IBAN formats differ by country, and an operator banking
  // outside the UAE must not be locked out by a regex tuned for AE IBANs.
  bankName          String @default("")
  bankAccountHolder String @default("")
  bankAccountNumber String @default("")
  bankIban          String @default("")

  // Commercial trade licence number, shown in the site footer.
  //
  // A legal disclosure, not a marketing string: a UAE business is expected to
  // publish it. "" hides the line entirely rather than printing a label with
  // nothing after it.
  tradeLicense      String @default("")

  // Google Maps location used by the footer map + settings preview
  mapLat       Float   @default(24.7614)
  mapLng       Float   @default(55.3340)
  mapZoom      Int     @default(10)
  addressLine  String? @default("دبي — الإمارات العربية المتحدة")

  // Theme — hex values injected as CSS custom properties on <html>.
  // See src/app/layout.tsx and src/styles/theme.ts.
  colorAccent     String @default("#C9A44C") // --gold-500
  colorAccentDeep String @default("#A8873A") // --gold-600
  colorNight      String @default("#0C1522") // --night-900
  colorSand       String @default("#FBF7F0") // --sand-50

  // Booking commercials
  //
  // serviceFeePercent defaults to 0: the platform charges no separate service
  // fee, so the total a guest sees is exactly the nightly price they were
  // quoted. The column stays because the arithmetic still has to live
  // somewhere, and an operator who later wants a fee can switch it back on from
  // /admin/settings — but at 0 every fee row disappears from the interface
  // rather than rendering "0%". See `quote()` in src/lib/pricing.ts.
  serviceFeePercent Int     @default(0)
  depositPercent    Int     @default(30)
  freeCancelHours   Int     @default(48)

  // ---------------------------------------------------------------------
  // The platform's fallback arrival and departure hours, as numbers.
  //
  // 0–23, or null for "nobody has picked one yet". Everything a visitor reads
  // is generated from these by `formatHour()` in src/lib/clock.ts, so one
  // stored 16 prints "٤:٠٠ مساءً" and "4:00 PM" without an operator writing
  // either of them.
  //
  // The four `*Time` / `*TimeEn` columns below them are what these replace.
  // They are NOT dead: they are the middle tier of the fallback, kept because
  // dropping them would have been a truthfulness regression. An operator who
  // had typed "٣ عصرًا" — genuinely not the platform's four o'clock — would
  // have had that answer replaced by the new column's default and started
  // advertising an hour they never chose. So the hour wins where one is set,
  // the old text answers where it isn't, and a row nobody migrates renders
  // exactly as it does today. See `resolveStayTimes` in src/lib/policies.ts.
  //
  // Nullable rather than `@default(16)` for the same reason: a default would
  // have silently overwritten every operator's existing text on deploy.
  checkInHour  Int?
  checkOutHour Int?

  // Legacy free text — read only while the hour above is null. Emptied row by
  // row as operators pick an hour; `npm run policy-audit` lists what is left.
  checkInTime       String  @default("٤ عصرًا")
  checkOutTime      String  @default("١٢ ظهرًا")

  // ---------------------------------------------------------------------
  // The platform's commission — a separate thing from `serviceFeePercent`,
  // and the difference is who pays.
  //
  //   serviceFeePercent — added ON TOP of the nights, paid by the GUEST.
  //                       Now 0: the total is the price that was advertised.
  //   commissionPercent — taken OUT of what the owner collected, paid by the
  //                       OWNER, by bank transfer, at step 6 of the booking
  //                       workflow. Never added to `total`, never shown to the
  //                       guest — they already paid it inside the nightly rate.
  //
  // Collapsing the two would mean either charging the guest twice or losing the
  // platform's revenue the moment the service fee went to 0.
  commissionPercent Int @default(5)

  // How long a guest's review link stays usable, in days. The link is issued at
  // step 7, once the stay is fully closed out — see `ReviewInvite`.
  reviewInviteDays Int @default(15)

  // Future online deposit payments. Keep false until a gateway is wired —
  // see src/lib/payments/index.ts for the disabled stub.
  depositPaymentsEnabled Boolean @default(false)

  // SEO
  seoTitle       String? @default("حجز الاستراحات والشاليهات في الإمارات")
  seoDescription String? @default("استراحات وشاليهات صحراوية موثّقة في دبي وأبوظبي والعين وليوا والشارقة — أسعار واضحة وتقويم متاح لحظيًا وتأكيد مباشر عبر الواتساب.")
  ogImageUrl     String?

  // Home hero copy (editable so the front page can change without a deploy)
  heroTitle    String  @default("استراحتك في قلب الصحراء")
  heroTitleAlt String  @default("تبدأ بحجز واحد")
  heroSubtitle String  @default("اختر من بين استراحات وشاليهات مختارة بعناية في لهباب وليوا والعين — أسعار واضحة، تقويم متاح لحظيًا، وتأكيد مباشر مع المالك.")
  heroImageUrl String?
  footerAbout  String  @default("منصّة إماراتية لحجز الاستراحات والشاليهات الصحراوية — موثّقة ميدانيًا وبأسعار واضحة.")

  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Listing — one استراحة / chalet.
// ---------------------------------------------------------------------------
model Listing {
  id   String @id @default(cuid())
  slug String @unique // used in /listings/[slug]; generated from the Arabic name

  name        String
  description String @default("")

  // Location. `city` is one of the ids in src/lib/constants.ts CITIES so the
  // filter chips stay stable even if the Arabic label is re-worded later.
  city String
  area String @default("")

  // ---------------------------------------------------------------------
  // English siblings for the three fields an owner writes in free text.
  //
  // Everything else on a listing is already bilingual for free: city, amenity
  // and category labels are ids resolved through `label()` in
  // src/lib/constants.ts, and prices and capacities are numbers. These three
  // are the only stored *prose*, which is why an otherwise-English page still
  // showed an Arabic title, an Arabic description and an Arabic location —
  // exactly the gap reported after the bilingual release.
  //
  // Modelled on the `*En` columns of SiteSettings, and for the same reason:
  // nullable with no default, so null/blank means "fall back to the Arabic
  // value" via `localizeListing()` in src/lib/listings.ts. That makes the
  // migration pure DDL with nothing to backfill, and it means an owner who
  // never fills these in keeps precisely the behaviour they have today.
  //
  // `slug` is deliberately NOT duplicated. One listing keeps one Arabic-derived
  // URL in both languages — see the locale-cookie note in src/lib/i18n/config.ts
  // for why the two languages share a URL at all.
  // ---------------------------------------------------------------------
  nameEn        String?
  descriptionEn String?
  areaEn        String?
  lat  Float  @default(24.7614)
  lng  Float  @default(55.3340)

  // Pricing in AED (whole dirhams — no fractional fils in this market)
  pricePerNight Int
  weekendPrice  Int @default(0) // 0 → falls back to pricePerNight
  capacity      Int @default(20)

  // ---------------------------------------------------------------------
  // Which days `weekendPrice` applies to. "short" | "long" — see the block
  // comment above `isWeekend` in src/lib/dates.ts for the full reasoning.
  //
  //   "short" — Saturday + Sunday.            The UAE weekend.
  //   "long"  — Friday + Saturday + Sunday.   Sharjah's four-day working week
  //             means Friday is a day off there, and a Sharjah rest house is
  //             full on Friday night while a Dubai one is not.
  //
  // A per-listing column and not a platform setting: an operator serving both
  // emirates needs both answers at once, and it is a commercial term of the
  // individual venue exactly like the nightly price. Owners in Sharjah asked
  // for it by name.
  //
  // A String rather than an enum, matching how every other id in this schema is
  // stored (see the portability note at the top) — reads normalise through
  // `toWeekendMode()`, which falls back to "short" rather than pricing a stay
  // with an undefined day set.
  weekendMode String @default("short")

  // ---------------------------------------------------------------------
  // Day-use (حجز بدون مبيت) — the guest arrives and leaves the same day.
  //
  // Informational, not bookable. The calendar, the quote and every stored
  // amount are built on *nights*: `nightsBetween` refuses a zero-night range
  // and `Availability` blocks whole days. Making a same-day stay bookable would
  // mean a second set of semantics through all of that, which is a much larger
  // change than "publish the price". So these are published on the listing page
  // and the guest arranges a day booking with the owner on WhatsApp — which is
  // how the overnight flow ends anyway.
  //
  // 0 means "not offered" and renders nothing at all: an owner who leaves these
  // blank sees exactly the page they have today.
  //
  // `dayUseCheckOutHour` is the hour the guest must be out by, 0–23. null here
  // means "not offered", NOT "inherit" — and that difference is load-bearing.
  // The arrival and departure hours above fall back to the platform's when a
  // listing leaves them unset; this one must never do that, or every rest house
  // that does not do day bookings would start advertising a leave-by time for a
  // booking it does not take. See `resolveDayUseCheckOut` in
  // src/lib/policies.ts, which deliberately has no platform tier.
  dayUsePrice          Int    @default(0) // weekdays, no overnight stay
  dayUseWeekendPrice   Int    @default(0) // Friday/Saturday, no overnight stay
  dayUseCheckOutHour   Int?
  // Legacy free text — read only while the hour above is null, per the note on
  // SiteSettings.checkInHour.
  dayUseCheckOutTime   String @default("")
  dayUseCheckOutTimeEn String?

  // Refundable security deposit (مبلغ التأمين), collected by the owner and
  // returned once the stay ends and the rest house has been checked.
  //
  // Deliberately NOT part of `total`: it is not a cost of the booking, it is
  // money that comes back. Adding it would make the headline total disagree
  // with the price the guest was quoted — the exact thing removing the service
  // fee was meant to fix. It is shown on its own line, labelled refundable.
  // 0 hides it everywhere.
  securityDeposit Int @default(0)

  // JSON string arrays of ids — see the portability note at the top.
  // amenities: ["pool","wifi",…]  categories: ["family","wedding",…]
  amenities  String @default("[]")
  categories String @default("[]")

  // ---------------------------------------------------------------------
  // The rest house's own Instagram profile.
  //
  // Distinct from `SiteSettings.instagram`, which is the *platform's* account
  // in the footer. This one belongs to the individual rest house: guests here
  // routinely want to see a venue's own feed — more photos, more recent, and
  // from other guests — before they commit to a booking, and the alternative is
  // that they leave the site to search for it and may not come back.
  //
  // A full URL, matching how the platform's own social links are stored, so the
  // detail page links it directly with no reconstruction from a handle. Handles
  // are ambiguous (with or without the "@", profile vs. explore path) and a URL
  // is what an owner has in their clipboard anyway.
  //
  // Nullable and null by default: an owner with no Instagram gets no icon at
  // all, rather than one that opens instagram.com's home page.
  instagram String?

  // Presentation flags
  verified  Boolean @default(false)
  featured  Boolean @default(false)
  published Boolean @default(true)

  // Denormalised review aggregates, recomputed on review write
  // (`recalcListingRating` in src/lib/reviews.ts). 0 reviews renders the
  // design's "استراحة جديدة — لا تقييمات بعد" state.
  rating       Float @default(0)
  reviewsCount Int   @default(0)
  bookingsCount Int  @default(0)

  // ---------------------------------------------------------------------
  // The rest house's own stay policy — arrival, departure, free cancellation.
  //
  // These three used to exist ONLY on SiteSettings, which made them one
  // platform-wide answer printed on every listing page. They are not: an owner
  // who hands over the keys at 3pm and another who does it at 5pm were both
  // being advertised as "٤ عصرًا", and the guest arrives to a locked gate. Each
  // rest house has its own policy, so each listing stores its own.
  //
  // ─── Blank / null means "inherit", and null is not 0 ──────────────────
  // `checkInHour` / `checkOutHour` are 0–23, null meaning "use the platform's".
  // They replaced four free-text columns an owner had to fill in twice, once
  // per language — see the note on SiteSettings.checkInHour for why the text
  // columns below survive as the middle tier of the fallback rather than being
  // dropped, and src/lib/clock.ts for why an hour is a number here.
  //
  // `freeCancelHours` follows `depositPercent` instead, and for the same
  // reason: null and 0 are genuinely different answers. null = "use the
  // platform's 48 hours", 0 = "I allow no free cancellation at all". Resolve
  // it with `resolveFreeCancelHours()` in src/lib/policies.ts — a truthiness
  // check would turn every no-free-cancellation listing back into a 48-hour
  // one, which is a promise the platform would be making on the owner's behalf.
  checkInHour    Int?
  checkOutHour   Int?
  // Legacy free text — read only while the matching hour above is null.
  checkInTime    String  @default("")
  checkInTimeEn  String?
  checkOutTime   String  @default("")
  checkOutTimeEn String?

  // ---------------------------------------------------------------------
  // What this rest house says about cancelling. One of CANCEL_POLICIES in
  // src/lib/policies.ts, or "" for a listing that predates the list.
  //
  //   "NONE" | "H24" | "H48" | "H72" | "H120" | "ASK"
  //
  // A named mode rather than a number because "اسأل المالك" — how a great many
  // of these arrangements actually work — is not a count of hours, and the
  // obvious `-1` sentinel is destroyed by `clampHours`, which floors at 0 and
  // would turn "ask me" into "no free cancellation at all". A String with a
  // read-side normaliser, exactly like `weekendMode`.
  //
  // `freeCancelHours` below is NOT dead: it is the middle tier, read whenever
  // this is "". Backfilling those rows would have frozen today's platform
  // window onto the whole catalogue and deleted the inheritance that null
  // means. See `resolveCancelPolicy`.
  cancelPolicy   String  @default("")

  freeCancelHours Int?

  // Deposit the owner asks for, as a whole percentage of the booking total.
  //
  // null = "use the platform default" (SiteSettings.depositPercent), which is
  // what every listing created before owners could set their own resolves to.
  // 0 is a meaningful, distinct value: "no deposit required". Resolve it with
  // `resolveDepositPercent()` in src/lib/pricing.ts — never read it directly,
  // or a null will silently become a 0% deposit.
  depositPercent Int?

  // ---------------------------------------------------------------------
  // Owner.
  //
  // Nullable and load-bearing: listings that predate the owner workflow (the
  // seeded catalogue, anything an admin created directly) have no owner and
  // must stay publicly visible. `publicListingWhere()` treats a null owner as
  // "platform-owned, always eligible" and gates only owned listings on the
  // owner's status and membership.
  // ---------------------------------------------------------------------
  ownerId String?
  owner   OwnerProfile? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  // Legacy per-listing owner contact, kept for platform-owned listings and for
  // backwards compatibility with rows created before OwnerProfile existed.
  //
  // For an *owned* listing these are not the source of truth: the WhatsApp
  // number resolves through the owner relation, so an owner who changes their
  // number changes every one of their listings at once. See
  // `resolveListingWhatsapp()` in src/lib/whatsapp.ts.
  ownerName     String? @default("المالك")
  ownerWhatsapp String?

  images        ListingImage[]
  availability  Availability[]
  bookings      BookingRequest[]
  reviews       Review[]
  reviewInvites ReviewInvite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([published, featured])
  @@index([ownerId])
}

// ---------------------------------------------------------------------------
// Image bytes stored IN the database.
//
// Used when STORAGE_DRIVER="db" (the default inside the Docker image). Trading
// disk for rows buys one specific thing: a completely stateless container. No
// volume to mount, no bind path to get wrong, and `pg_dump` captures the site
// *and* its photos in a single backup — restore it anywhere and the gallery
// comes back with it.
//
// `Bytes` maps to BLOB on SQLite and bytea on PostgreSQL, so this stays as
// portable as the rest of the schema.
//
// The trade-off, stated plainly: every image read is a database read rather than
// a static file served by the OS. Mitigated by immutable long-lived cache
// headers plus ETags on /api/images/[id] (a row's bytes never change — a new
// upload is a new row), and by Next's image optimiser caching derived sizes. At
// a few hundred photos this is a non-issue; if the catalogue reaches thousands
// of images with heavy traffic, switch STORAGE_DRIVER to s3/cloudinary — the
// adapter interface means no other code changes.
// ---------------------------------------------------------------------------
model StoredImage {
  id        String   @id @default(cuid())
  mimeType  String
  data      Bytes
  size      Int
  folder    String   @default("listings")
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Gallery images. `url` is whatever the storage adapter returned — a local
// /uploads/… path, an /api/images/… path when stored in the database, or a
// remote CDN URL. See src/lib/storage.
// ---------------------------------------------------------------------------
model ListingImage {
  id        String  @id @default(cuid())
  listingId String
  url       String
  alt       String  @default("")
  sortOrder Int     @default(0)
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sortOrder])
}

// ---------------------------------------------------------------------------
// Availability — one row per unavailable day, per listing.
//
// `date` is a plain "YYYY-MM-DD" string, NOT a DateTime. Storing calendar days
// as timestamps is the classic source of off-by-one bugs: `new Date(2026,6,25)`
// is local midnight, which serialises to the previous day in any timezone west
// of UTC, so a day the owner blocked shows as available to some visitors.
// A date-only string has no timezone to get wrong. Helpers: src/lib/dates.ts
//
// status: "BLOCKED" (owner closed the day) | "BOOKED" (confirmed reservation)
// Both render as unavailable to visitors; the distinction is for the owner.
// ---------------------------------------------------------------------------
model Availability {
  id        String  @id @default(cuid())
  listingId String
  date      String // YYYY-MM-DD
  status    String  @default("BLOCKED")
  note      String?
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, date])
  @@index([listingId])
}

// ---------------------------------------------------------------------------
// Booking request. Saved BEFORE the WhatsApp link opens, so the owner has a
// record even if the customer never sends the message — and so the prefilled
// message can quote the request reference.
// ---------------------------------------------------------------------------
model BookingRequest {
  id        String @id @default(cuid())
  reference String @unique // human-friendly, e.g. "RQ-2419"

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  customerName  String
  customerPhone String
  customerEmail String?
  notes         String?

  checkIn  String // YYYY-MM-DD — same date-only rule as Availability
  checkOut String // YYYY-MM-DD (exclusive: guest leaves this morning)
  nights   Int
  guests   Int

  // ---------------------------------------------------------------------
  // A day-use booking (حجز بدون مبيت): arrive and leave on the same day.
  //
  // For one of these, `checkIn === checkOut` and `nights === 0`. Both are the
  // literal truth rather than a workaround, and storing the truth is what the
  // rest of this model already does everywhere else.
  //
  // The tempting alternative was to store `checkOut = checkIn + 1` and
  // `nights = 1`, which would have let the existing night-based machinery run
  // untouched. It was rejected: it stores a lie. Every screen, every WhatsApp
  // message and every future query would then have to remember to undo it —
  // subtracting a day before display, special-casing "1 night" that is not a
  // night — and the first place that forgot would quietly tell a guest they were
  // staying over.
  //
  // What the flag buys, concretely:
  //   * `quote()` prices from `Listing.dayUsePrice` instead of the nightly rate.
  //     Without it, `nightsInRange` returns [] for a same-day range, the
  //     subtotal is 0, and the booking is free.
  //   * `occupiedDays()` (src/lib/dates.ts) yields the single day, so
  //     confirmation blocks the calendar. Without it, nothing is blocked and the
  //     day stays bookable by somebody else.
  //
  // Defaults false, so every row that predates this is an overnight stay —
  // which every one of them was.
  dayUse   Boolean @default(false)

  // Price snapshot at request time. Stored so a later price change on the
  // listing does not silently rewrite the history of what was quoted.
  subtotal     Int
  serviceFee   Int
  total        Int
  depositDue   Int @default(0)

  // The deposit *rate* that produced `depositDue`, snapshotted alongside it.
  //
  // Without this the percentage shown on an old booking would be re-derived
  // from the listing's current setting, so an owner moving from 25% to 50%
  // would retroactively relabel every past booking — the stored amount saying
  // one thing and the displayed rate another. Existing rows are backfilled
  // from SiteSettings.depositPercent by the migration.
  depositPercent Int @default(30)

  // The refundable security deposit the listing asked for, snapshotted like
  // every other amount here. Read from this column — never re-derived from the
  // listing — so a later change to the owner's figure cannot rewrite what an
  // existing request quoted. 0 on every row that predates the column, which is
  // also what "no security deposit" means.
  securityDeposit Int @default(0)

  // The platform's commission on this booking, snapshotted at request time for
  // the same reason every other amount here is: a later change to
  // SiteSettings.commissionPercent must not rewrite what an owner already owes.
  // This is money the owner remits to the platform at step 6 — it is NOT part
  // of `total` and the guest never sees it.
  commissionPercent Int @default(5)
  commissionDue     Int @default(0)

  // "NEW" | "CONFIRMED" | "REJECTED" | "CANCELLED"
  status String @default("NEW")

  // ---------------------------------------------------------------------
  // Workflow stage — one of BOOKING_STAGES in src/lib/constants.ts.
  //
  // Deliberately ORTHOGONAL to `status`, not an extension of it. `status`
  // answers "does this booking hold the calendar?" and is what
  // `BOOKING_STATUSES`, the filter chips, `StatusBadge`, `listBookings` and the
  // public /booking/[reference] page all key off. `stage` answers "how far
  // through the handover is the owner?" — which only exists at all once the
  // booking is CONFIRMED.
  //
  // Folding the seven steps into `status` was the obvious move and the wrong
  // one: every one of those call sites would have had to learn six new values
  // that mean "confirmed, still", and a stage list that grows later would break
  // them again. Two columns, each with one job.
  //
  // "DEPOSIT" is the resting state for a request nobody has answered yet, so a
  // NEW / REJECTED / CANCELLED row simply carries the stage it would start at.
  stage String @default("DEPOSIT")

  // ---------------------------------------------------------------------
  // What each step actually recorded.
  //
  // The amounts are nullable on purpose: NULL means "this step has not been
  // completed", which is genuinely different from 0 ("completed, and nothing
  // was collected" — a booking with no deposit, or a security deposit returned
  // in full with no deduction). A `@default(0)` would erase that distinction
  // and the stepper could no longer tell a skipped step from a free one.
  //
  // Each is the figure the OWNER confirms, not the figure the system quoted:
  // `depositDue` is what was asked for, `depositCollected` is what arrived —
  // and those differ whenever the two of them settled on something else over
  // WhatsApp, which is the normal case here, not the exception.
  depositCollected  Int? // step 1 — عربون actually received
  securityCollected Int? // step 1 — تأمين actually received
  balanceCollected  Int? // step 2 — the rest of the booking value
  damageDeduction   Int? // step 5 — withheld from the security deposit
  securityReturned  Int? // step 5 — handed back to the guest
  inspectionNotes   String? // step 4 — what the owner found

  // The owner's bank-transfer reference for the commission, typed at step 6 so
  // the operator confirming it at the same step has something to match against.
  commissionReference String?

  // One timestamp per completed step, rather than a separate event table.
  //
  // The stepper renders from a single booking row — it is drawn once per card
  // in a list of dozens, and a join per card to reconstruct "which steps are
  // done" would be a query per card for information that is seven booleans
  // wide. The audit trail of *who* pressed each button lives in AuditLog, which
  // is where consequential actions already go.
  depositConfirmedAt    DateTime? // step 1 — booking confirmed, calendar closed
  balancePaidAt         DateTime? // step 2
  checkedOutAt          DateTime? // step 3
  inspectedAt           DateTime? // step 4
  securityReturnedAt    DateTime? // step 5
  commissionSentAt      DateTime? // step 6 — owner says the transfer went out
  commissionConfirmedAt DateTime? // step 6 — operator says it arrived
  reviewInvitedAt       DateTime? // step 7 — the guest's link was issued

  // Future online deposit: "NONE" | "PENDING" | "PAID" | "REFUNDED".
  // Nothing writes anything but "NONE" until a gateway is enabled.
  paymentStatus    String  @default("NONE")
  paymentReference String?

  reviewInvite ReviewInvite?
  review       Review?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([listingId])
  @@index([dayUse])
  // Drives the owner's "what needs me next" queue and the operator's
  // commission-to-confirm list, both of which filter on stage within status.
  @@index([status, stage])
}

// ---------------------------------------------------------------------------
// ReviewInvite — the temporary link a guest uses to review a stay.
//
// Issued at step 7, once the booking has been paid, checked out, inspected and
// settled, so only a guest who genuinely completed a stay can ever be asked.
//
// ─── The token is the entire authentication ─────────────────────────────────
// This platform has no customer accounts — a guest books with a name and a
// WhatsApp number and never signs up (see the note on `listCustomers` in
// src/lib/admin-queries.ts). So there is nobody to log in, and the link itself
// has to carry the authority. That makes three properties load-bearing:
//   * the token is 32 random bytes from `crypto.randomBytes`, not a cuid and
//     not derived from the booking — it must not be guessable from a reference
//     number a guest can read off their own confirmation page
//   * `expiresAt` is checked server-side on every visit, never in the UI
//   * `usedAt` makes it single-use, so a forwarded link cannot be replayed
// The page it opens shows nothing but the one rest house being reviewed.
// ---------------------------------------------------------------------------
model ReviewInvite {
  id    String @id @default(cuid())
  token String @unique

  bookingId String         @unique
  booking   BookingRequest @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([listingId])
}

// ---------------------------------------------------------------------------
// Guest reviews. Moderated: `published` must be true to appear on the site.
// ---------------------------------------------------------------------------
model Review {
  id         String  @id @default(cuid())
  listingId  String
  listing    Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  authorName String
  rating     Int     @default(5) // 1..5
  body       String
  published  Boolean @default(true)
  createdAt  DateTime @default(now())

  // ---------------------------------------------------------------------
  // Moderation state — one of REVIEW_STATUSES in src/lib/constants.ts:
  //   "PENDING"  — submitted through a review link, waiting on an operator
  //   "APPROVED" — live (paired with published = true)
  //   "REJECTED" — refused; kept rather than deleted so the same invite can't
  //                be spent again on a second attempt at the same complaint
  //
  // `published` is NOT replaced by this. It stays the single switch every
  // public query already filters on (`where: { published: true }` in
  // src/lib/listings.ts), so nothing on the visitor side had to change and the
  // seeded catalogue keeps its reviews. The default is "APPROVED" for exactly
  // that reason: every existing row is already published, and a default of
  // "PENDING" would have contradicted the column beside it.
  //
  // A review arriving through an invite is written PENDING **and**
  // published: false, explicitly — see `submitReview` in src/lib/reviews.ts.
  status String @default("APPROVED")

  // The stay being reviewed, when the review came from an invite. Null for the
  // seeded catalogue and anything an operator adds by hand.
  bookingId String?         @unique
  booking   BookingRequest? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([listingId, published])
  @@index([status])
}
