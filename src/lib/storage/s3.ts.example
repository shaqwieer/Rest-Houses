/* ---------------------------------------------------------------------------
 * S3-compatible adapter — works with AWS S3, Cloudflare R2, DigitalOcean
 * Spaces, MinIO and anything else speaking the S3 API.
 *
 *   1. npm install @aws-sdk/client-s3
 *   2. rename this file to s3.ts
 *   3. in src/lib/storage/index.ts replace the `case "s3":` throw with:
 *          cached = new S3StorageAdapter();
 *          break;
 *   4. .env:
 *          STORAGE_DRIVER="s3"
 *          S3_REGION="me-central-1"
 *          S3_BUCKET="my-bucket"
 *          S3_ACCESS_KEY_ID="..."
 *          S3_SECRET_ACCESS_KEY="..."
 *          S3_ENDPOINT=""              # blank for AWS; set for R2/MinIO/Spaces
 *          S3_PUBLIC_BASE_URL="https://cdn.example.ae"
 *   5. add your CDN hostname to images.remotePatterns in next.config.ts.
 * ------------------------------------------------------------------------- */

import { randomUUID } from "node:crypto";
import { DeleteObjectCommand, PutObjectCommand, S3Client } from "@aws-sdk/client-s3";
import { assertValidImage, type StorageAdapter, type StoredFile } from "./types";

const BUCKET = process.env.S3_BUCKET!;
const PUBLIC_BASE = (process.env.S3_PUBLIC_BASE_URL ?? "").replace(/\/$/, "");

const client = new S3Client({
  region: process.env.S3_REGION,
  // Custom endpoint for R2 / MinIO / Spaces. `forcePathStyle` is what MinIO wants.
  ...(process.env.S3_ENDPOINT
    ? { endpoint: process.env.S3_ENDPOINT, forcePathStyle: true }
    : {}),
  credentials: {
    accessKeyId: process.env.S3_ACCESS_KEY_ID!,
    secretAccessKey: process.env.S3_SECRET_ACCESS_KEY!,
  },
});

const EXT_BY_TYPE: Record<string, string> = {
  "image/jpeg": "jpg",
  "image/png": "png",
  "image/webp": "webp",
  "image/avif": "avif",
};

export class S3StorageAdapter implements StorageAdapter {
  readonly name = "s3";

  async save(file: File, opts?: { folder?: string }): Promise<StoredFile> {
    assertValidImage(file);

    const folder = (opts?.folder ?? "listings").replace(/[^a-z0-9-]/gi, "");
    const ext = EXT_BY_TYPE[file.type] ?? "jpg";
    const key = `${folder}/${randomUUID()}.${ext}`;
    const body = Buffer.from(await file.arrayBuffer());

    await client.send(
      new PutObjectCommand({
        Bucket: BUCKET,
        Key: key,
        Body: body,
        ContentType: file.type,
        CacheControl: "public, max-age=31536000, immutable",
      }),
    );

    const url = PUBLIC_BASE
      ? `${PUBLIC_BASE}/${key}`
      : `https://${BUCKET}.s3.${process.env.S3_REGION}.amazonaws.com/${key}`;

    return { url, key, bytes: body.byteLength };
  }

  async delete(keyOrUrl: string): Promise<void> {
    const key = keyOrUrl.startsWith("http")
      ? new URL(keyOrUrl).pathname.replace(/^\//, "")
      : keyOrUrl;
    try {
      await client.send(new DeleteObjectCommand({ Bucket: BUCKET, Key: key }));
    } catch {
      // Idempotent by contract.
    }
  }
}
